<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for public marketing routes. Job/fatwa/institution
  dynamic URLs will be added by a build-time generator (see scripts/gen-sitemap.mjs — TODO)
  that queries Supabase and appends per-row <url> entries at deploy time.

  Every URL includes xhtml:link alternates for bn / en / ar so Google
  serves the right language variant to each searcher.
-->
