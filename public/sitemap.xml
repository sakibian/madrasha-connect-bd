<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for public marketing routes. Job/fatwa/institution
  dynamic URLs will be added by a build-time generator (see scripts/gen-sitemap.mjs — TODO)
  that queries Supabase and appends per-row <url> entries at deploy time.

  Every URL includes xhtml:link alternates for bn / en / ar so Google
  serves the right language variant to each searcher.
-->
<urlset
    xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
    xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <url>
    <loc>https://qowmi.mvp.bd/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="bn" href="https://qowmi.mvp.bd/" />
    <xhtml:link rel="alternate" hreflang="en" href="https://qowmi.mvp.bd/?lang=en" />
    <xhtml:link rel="alternate" hreflang="ar" href="https://qowmi.mvp.bd/?lang=ar" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://qowmi.mvp.bd/" />
  </url>

