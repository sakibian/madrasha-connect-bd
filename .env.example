# ---------------------------------------------------------------------------
# Madrasa Connect BD — Web app environment variables
#
# Copy this file to `.env.local` (gitignored) and fill in real values.
# All VITE_* variables are inlined at build time and shipped to the browser,
# so ONLY use publishable / anon keys here. Never put service-role keys.
# ---------------------------------------------------------------------------

# --- Supabase (required for auth, DB, storage, edge functions) --------------
# Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Sentry (recommended for production error monitoring) -------------------
# Sentry → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# --- PostHog (recommended for product analytics) ----------------------------
# PostHog → Project Settings → API Keys
VITE_POSTHOG_KEY=your_posthog_public_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature flags ----------------------------------------------------------
# Set to "true" ONLY in local dev / demo environments. Never in production.
VITE_ENABLE_DEMO=false

# --- Web Push (VAPID) -------------------------------------------------------
# Public key inlined at build time for client-side subscription.
# Generate keys with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# The following secrets are NOT read by the web app.
# They live in Supabase Edge Function secrets, set via:
#   supabase secrets set GEMINI_API_KEY=your-key
#   supabase secrets set VAPID_PRIVATE_KEY=your-private-key
#   supabase secrets set VAPID_PUBLIC_KEY=your-public-key
#   supabase secrets set VAPID_SUBJECT=mailto:your-email@example.com
# and are only referenced by supabase/functions/*.
#
#   GEMINI_API_KEY=<paste-in-supabase-only>
#   VAPID_PRIVATE_KEY=<paste-in-supabase-only>
#   VAPID_PUBLIC_KEY=<paste-in-supabase-only>
#   VAPID_SUBJECT=mailto:support@madrasa-connect.bd
# ---------------------------------------------------------------------------
